{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve static site",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "static-site-server",
                "pattern": {
                    "regexp": "^(Serving HTTP on .*)$",
                    "message": 1
                },
                "background": {
                    "beginsPattern": "^Serving HTTP on .*",
                    "endsPattern": "^Serving HTTP on .*"
                }
            }
        }
    ]
}
